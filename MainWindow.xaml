<Window x:Class="WheelBridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="458 Spider Bridge" Height="760" Width="440" MinHeight="600" MinWidth="420"
        Icon="app.ico"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" Padding="18,16">
            <StackPanel>
                <TextBlock Text="458 SPIDER" FontWeight="Bold" FontSize="20" Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="Xbox 360 bridge · bungee wheel" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <TabControl>
            <TabItem Header="STATUS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14">

                    <!-- Connection badges -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="WheelDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="WHEEL" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="10,6">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="VigemDot" Width="8" Height="8" Fill="{StaticResource MutedTextBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="VIGEMBUS" FontSize="11" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="StatusMessageText" Style="{StaticResource HintText}" Margin="0,0,0,12"/>

                    <!-- Steering gauge -->
                    <TextBlock Text="STEERING" Style="{StaticResource SectionLabel}"/>
                    <Grid Height="28">
                        <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="SteerLeftFill" Grid.Column="0" HorizontalAlignment="Right" Width="0" Fill="{StaticResource AccentDimBrush}" RadiusX="4" RadiusY="4"/>
                            <Rectangle x:Name="SteerRightFill" Grid.Column="1" HorizontalAlignment="Left" Width="0" Fill="{StaticResource AccentDimBrush}" RadiusX="4" RadiusY="4"/>
                        </Grid>
                        <Rectangle Width="2" HorizontalAlignment="Center" Fill="{StaticResource MutedTextBrush}"/>
                        <TextBlock x:Name="SteerValueText" Text="0.00" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="Bold"/>
                    </Grid>

                    <!-- Pedals -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="THROTTLE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <Grid Height="70">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"/>
                                <Rectangle x:Name="ThrottleFill" VerticalAlignment="Bottom" Height="0" Fill="{StaticResource GoodBrush}" RadiusX="4" RadiusY="4"/>
                                <TextBlock x:Name="ThrottleValueText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="BRAKE" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <Grid Height="70">
                                <Border Background="{StaticResource SurfaceBrush}" CornerRadius="4"/>
                                <Rectangle x:Name="BrakeFill" VerticalAlignment="Bottom" Height="0" Fill="{StaticResource BadBrush}" RadiusX="4" RadiusY="4"/>
                                <TextBlock x:Name="BrakeValueText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- Buttons -->
                    <TextBlock Text="BUTTONS" Style="{StaticResource SectionLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- D-pad + shoulders cluster -->
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <Border x:Name="ChipLB" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,0,10" HorizontalAlignment="Center">
                                <TextBlock Text="LB" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Grid Width="108" Height="108">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="ChipUp" Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Margin="2">
                                    <TextBlock Text="▲" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="ChipLeft" Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Margin="2">
                                    <TextBlock Text="◀" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SurfaceAltBrush}" CornerRadius="4" Margin="2"/>
                                <Border x:Name="ChipRight" Grid.Row="1" Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Margin="2">
                                    <TextBlock Text="▶" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Border x:Name="ChipDown" Grid.Row="2" Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Margin="2">
                                    <TextBlock Text="▼" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                            </Grid>
                        </StackPanel>

                        <!-- Face buttons + shoulders cluster -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <Border x:Name="ChipRB" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="10,5" Margin="0,0,0,10" HorizontalAlignment="Center">
                                <TextBlock Text="RB" FontSize="11" FontWeight="Bold"/>
                            </Border>
                            <Grid Width="108" Height="108">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="ChipY" Grid.Row="0" Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Margin="2">
                                    <TextBlock Text="Y" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <Border x:Name="ChipX" Grid.Row="1" Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Margin="2">
                                    <TextBlock Text="X" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <Border x:Name="ChipB" Grid.Row="1" Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Margin="2">
                                    <TextBlock Text="B" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <Border x:Name="ChipA" Grid.Row="2" Grid.Column="1" Background="{StaticResource SurfaceBrush}" CornerRadius="18" Margin="2">
                                    <TextBlock Text="A" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Border x:Name="ChipBack" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="12,5" Margin="0,0,8,0">
                            <TextBlock Text="BACK" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border x:Name="ChipStart" Background="{StaticResource SurfaceBrush}" CornerRadius="4" Padding="12,5">
                            <TextBlock Text="START" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="SETTINGS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,14">
                    <TextBlock Text="STEERING" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Sensitivity" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="SensitivityValueText" Grid.Column="1" Text="1.0x" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SensitivitySlider" Minimum="0.5" Maximum="3.0" Value="1.0" TickFrequency="0.1" ValueChanged="SensitivitySlider_ValueChanged"/>
                    <TextBlock Text="Amplifies wheel deflection -- a bungee wheel's short physical rotation may never reach full lock without this." Style="{StaticResource HintText}" Margin="0,2,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Center deadzone" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="SteerDeadzoneValueText" Grid.Column="1" Text="3%" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SteerDeadzoneSlider" Minimum="0" Maximum="0.15" Value="0.03" ValueChanged="SteerDeadzoneSlider_ValueChanged"/>
                    <TextBlock Text="Absorbs spring slack/jitter near center from the bungee return." Style="{StaticResource HintText}" Margin="0,2,0,10"/>

                    <CheckBox x:Name="InvertSteeringCheck" Content="Invert steering" Checked="InvertSteeringCheck_Changed" Unchecked="InvertSteeringCheck_Changed"/>

                    <TextBlock Text="PEDALS" Style="{StaticResource SectionLabel}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Throttle deadzone" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="ThrottleDeadzoneValueText" Grid.Column="1" Text="2%" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="ThrottleDeadzoneSlider" Minimum="0" Maximum="0.2" Value="0.02" ValueChanged="ThrottleDeadzoneSlider_ValueChanged"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Brake deadzone" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="BrakeDeadzoneValueText" Grid.Column="1" Text="2%" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="BrakeDeadzoneSlider" Minimum="0" Maximum="0.2" Value="0.02" ValueChanged="BrakeDeadzoneSlider_ValueChanged"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Pedal curve" VerticalAlignment="Center" FontSize="12"/>
                        <TextBlock x:Name="PedalCurveValueText" Grid.Column="1" Text="linear" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="PedalCurveSlider" Minimum="0.5" Maximum="2.0" Value="1.0" ValueChanged="PedalCurveSlider_ValueChanged"/>
                    <TextBlock Text="Below 1.0 = more bite early in the pedal; above 1.0 = more gradual, harder to lock brakes." Style="{StaticResource HintText}" Margin="0,2,0,10"/>

                    <TextBlock Text="APP" Style="{StaticResource SectionLabel}"/>
                    <CheckBox x:Name="StartMinimizedCheck" Content="Start minimized to tray" Checked="AppOptionCheck_Changed" Unchecked="AppOptionCheck_Changed"/>
                    <CheckBox x:Name="LaunchAtStartupCheck" Content="Launch when Windows starts" Checked="AppOptionCheck_Changed" Unchecked="AppOptionCheck_Changed"/>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Content="Save" Style="{StaticResource AccentButton}" Click="SaveButton_Click" Margin="0,0,8,0"/>
                        <Button Content="Restore defaults" Click="RestoreDefaultsButton_Click"/>
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
